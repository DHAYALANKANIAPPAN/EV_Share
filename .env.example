# dev | production  (production enforces a strong secret and a real payment provider)
EVSHARE_ENV=dev
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
EVSHARE_SECRET_KEY=
EVSHARE_DATABASE_URL=sqlite:///./evshare.db
# Postgres example (pip install -r requirements-postgres.txt):
# EVSHARE_DATABASE_URL=postgresql+psycopg://evshare:evshare@localhost:5432/evshare
EVSHARE_ACCESS_TOKEN_MINUTES=60
EVSHARE_DEFAULT_TIMEZONE=Asia/Kolkata
# lock a (IP, email) pair out of login after this many failures within the window
# the unlinked reviewer portal page; choose something hard to guess in production, e.g. /review-x7k2
EVSHARE_STAFF_PATH=/staff
# hub "Go live": minutes a hub stays live after its last location ping, and how close (metres) the ping must be to a charger
EVSHARE_LIVE_TTL_MINUTES=30
EVSHARE_LIVE_RADIUS_M=500
EVSHARE_LOGIN_MAX_FAILURES=5
EVSHARE_LOGIN_WINDOW_MINUTES=15
# how many open requests/sessions a driver may hold at once (0 = unlimited)
EVSHARE_MAX_ACTIVE_BOOKINGS=1
# minutes a hub has to accept or decline a booking request (0 = no limit)
EVSHARE_HUB_RESPONSE_MINUTES=20
# minutes a driver has to pay after the hub accepts (0 = hold forever)
EVSHARE_UNPAID_HOLD_MINUTES=15

# Identity verification. Outside dev these are REQUIRED:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVSHARE_DOCS_ENCRYPTION_KEY=
EVSHARE_UPLOAD_DIR=./uploads
# console = print the OTP in the server log (dev only) | smtp = email it
EVSHARE_OTP_PROVIDER=console
EVSHARE_SMTP_HOST=
EVSHARE_SMTP_PORT=587
EVSHARE_SMTP_USER=
EVSHARE_SMTP_PASSWORD=
EVSHARE_SMTP_FROM=

# mock (dev only, no money moves) | razorpay
EVSHARE_PAYMENT_PROVIDER=mock
EVSHARE_RAZORPAY_KEY_ID=
EVSHARE_RAZORPAY_KEY_SECRET=
